# Postgres container bootstrap credentials (compose.yaml).
#
# Copy to .env.db and set a real password. .env.db is git-ignored.
# Keep these OUT of .env: application settings use extra="forbid"
# and will refuse to start if unknown keys are present.
#
# POSTGRES_PASSWORD must match the password in the application's
# DATABASE_URL.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=ultimatekits
