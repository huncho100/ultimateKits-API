APP_NAME=Ultimate Kits API
APP_VERSION=1.0.0

# Local development only. The application default is False, and it
# must stay False in production: DEBUG=True exposes /docs, /redoc
# and /openapi.json.
DEBUG=True

FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/ultimatekits

JWT_SECRET_KEY=your-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_EXPIRE_MINUTES=30

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=True

# Paystack. PAYSTACK_SECRET_KEY and PAYSTACK_PUBLIC_KEY are required
# and have no defaults - the application will not start without them.
# Use sk_test_/pk_test_ keys locally and sk_live_/pk_live_ in production.
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=http://localhost:5173/payment/callback
